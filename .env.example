# Copy this file to ".env" (same folder as manage.py) and fill it in.
# Django reads it automatically. On Render/Railway you can paste the same lines
# into the dashboard's environment settings instead.

# ── Django ──
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com,api.your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com
DJANGO_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=31536000

# ── Database (leave DB_ENGINE unset to keep SQLite) ──
# DB_ENGINE=postgres
# DB_NAME=vamsham
# DB_USER=vamsham
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# ── Browser admin panel (Expo web build) ──
# Web dashboard address(es) allowed to call the API
CORS_ALLOWED_ORIGINS=https://dashboard.vamsham.app,http://localhost:8081

# ── Login tokens ──
JWT_ACCESS_HOURS=12
JWT_REFRESH_DAYS=60

# ── OTP over SMS ──
# console = code is printed in the server log (development)
# msg91   = real SMS through MSG91 (needs a DLT-approved OTP template)
SMS_BACKEND=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
OTP_TTL_SECONDS=300
OTP_THROTTLE=30/hour
LOGIN_THROTTLE=30/hour
# Fixed number+code for Play Store / App Store reviewers (leave empty otherwise)
OTP_TEST_PHONE=
OTP_TEST_CODE=
# Demo mode: shows the code inside the app instead of sending an SMS (1 = on).
# Testing only — while on, anyone can sign in as any number. Set back to 0 before members use the app.
OTP_DEMO=0

# ── Push notifications through Expo (1 = on, 0 = off) ──
EXPO_PUSH=1
